<Page
    x:Class="ToDoListApp.Views.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <!-- Title Top Right -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,20,20,0" CornerRadius="12" Padding="20,10">
            <Border.Background>
                <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
            </Border.Background>
            <TextBlock x:Name="TitleText" Text="Widgets" FontSize="28" FontWeight="Bold" />
        </Border>

        <Border Margin="20,90,20,20" CornerRadius="12" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border.Background>
                <AcrylicBrush TintOpacity="0.8" />
            </Border.Background>
            <StackPanel Spacing="20">
                <ToggleSwitch x:Name="PomodoroWidgetToggle" Header="Enable Pomodoro Widget" IsOn="True"/>
                <ToggleSwitch x:Name="CalendarWidgetToggle" Header="Enable Calendar Widget" IsOn="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
