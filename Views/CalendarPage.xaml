<Page
    x:Class="ToDoListApp.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ToDoListApp.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <!-- Title Top Right -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,20,20,0" CornerRadius="12" Padding="20,10" Visibility="Collapsed">
            <Border.Background>
                <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
            </Border.Background>
            <TextBlock x:Name="TitleText" Text="Calendar" FontSize="28" FontWeight="Bold" />
        </Border>

        <!-- Main Content Area: 2 Columns (Tasks on Left, Calendar on Right) -->
        <Grid Margin="25,90,25,20">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Tasks list for the selected date -->
                <ColumnDefinition Width="*" />
                <!-- Column 1: Free space between tasks and calendar (120px) -->
                <ColumnDefinition Width="120" />
                <!-- Column 2: Calendar Card anchored to the right -->
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE: Tasks for Selected Date -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header for Selected Day -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedDateTitleText" Text="Today, September 30" FontSize="26" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedDateSubtext" Text="Tasks scheduled for this date" FontSize="14" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                    </StackPanel>

                    <!-- Add Task for this date button -->
                    <Button Grid.Column="1" Click="AddTaskForDate_Click" Style="{ThemeResource AccentButtonStyle}" Height="40" CornerRadius="8" Padding="16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock x:Name="AddTaskBtnText" Text="Add Task" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Tasks ListView -->
                <ListView x:Name="TasksListView" Grid.Row="1" ItemsSource="{x:Bind FilteredTasks, Mode=OneWay}" SelectionChanged="OnTaskSelected">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                            <RepositionThemeTransition IsStaggeringEnabled="False"/>
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5,0,5" CornerRadius="8" DataContextChanged="TaskCard_DataContextChanged">
                                <Grid.RenderTransform>
                                    <TranslateTransform/>
                                </Grid.RenderTransform>
                                <Grid.Background>
                                    <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
                                </Grid.Background>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Main Task Row -->
                                <Grid Padding="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              Click="TaskCheckBox_Click"
                                              Loaded="TaskCheckBox_Loaded"
                                              VerticalAlignment="Center"/>

                                    <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="16"/>
                                        <Border Height="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                                Background="{ThemeResource SystemAccentColor}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>

                                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="DeleteTask_Click" ToolTipService.ToolTip="Delete Task" Margin="0,0,5,0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </Button>

                                    <ToggleButton Grid.Column="3" x:Name="ExpandSubtasksBtn" Background="Transparent" BorderThickness="0" CornerRadius="4">
                                        <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>

                                <!-- Subtasks Panel -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Subtasks}" 
                                              Visibility="{Binding IsChecked, ElementName=ExpandSubtasksBtn, Converter={StaticResource BoolToVisibility}}"
                                              Margin="40,0,10,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4" DataContextChanged="SubtaskRow_DataContextChanged">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          Click="SubtaskCheckBox_Click"
                                                          Loaded="SubtaskCheckBox_Loaded"
                                                          VerticalAlignment="Center" MinWidth="0" MinHeight="0"/>
                                                <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                                                    <Border Height="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,3,0,0"
                                                            Background="{ThemeResource SystemBaseMediumColor}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="0"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State (when no tasks for this day) -->
                <Border x:Name="EmptyStatePanel" Grid.Row="1" CornerRadius="12" Padding="30" VerticalAlignment="Top" Margin="0,10,0,0" Visibility="Collapsed">
                    <Border.Background>
                        <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.6" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE787;" FontSize="44" Foreground="{ThemeResource SystemBaseMediumColor}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateTitleText" Text="No tasks for this date" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                        <TextBlock x:Name="EmptyStateSubtext" Text="Plan your day by adding your first task!" FontSize="13" Foreground="{ThemeResource SystemBaseMediumLowColor}" HorizontalAlignment="Center"/>
                        <Button x:Name="EmptyStateCreateTaskBtn" Content="+ Create Task for This Day" Click="AddTaskForDate_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT SIDE: Calendar Card -->
            <Border Grid.Column="2" CornerRadius="16" Padding="18" VerticalAlignment="Center">
                <Border.Background>
                    <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
                </Border.Background>
                <StackPanel Spacing="14">
                    <!-- Calendar Header Controls: Previous, Month/Year Title, Next, Today -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Previous Month Button -->
                        <Button x:Name="PrevMonthBtn" Grid.Column="0" Click="PrevMonth_Click" Height="36" Width="36" Padding="0" CornerRadius="8" BorderThickness="1" ToolTipService.ToolTip="Previous Month">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="#28FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#45FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1FFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="#33FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#55FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#22FFFFFF" />
                                <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource TextFillColorPrimary}" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE76B;" FontSize="13"/>
                        </Button>

                        <!-- Month & Year label -->
                        <TextBlock Grid.Column="1" x:Name="CalendarMonthText" Text="September 2026" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Next Month Button -->
                        <Button x:Name="NextMonthBtn" Grid.Column="2" Click="NextMonth_Click" Height="36" Width="36" Padding="0" CornerRadius="8" BorderThickness="1" ToolTipService.ToolTip="Next Month">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="#28FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#45FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1FFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="#33FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#55FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#22FFFFFF" />
                                <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource TextFillColorPrimary}" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xE76C;" FontSize="13"/>
                        </Button>

                        <!-- Today Button -->
                        <Button x:Name="GoToTodayBtn" Grid.Column="3" Click="GoToToday_Click" Content="Today" Margin="8,0,0,0" Height="36" Padding="14,0" CornerRadius="8" BorderThickness="1" FontSize="13" FontWeight="SemiBold">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="#28FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#45FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1FFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="#33FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#55FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#22FFFFFF" />
                                <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource TextFillColorPrimary}" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- The CalendarView Control -->
                    <CalendarView x:Name="MainCalendar"
                                  SelectionMode="Single"
                                  IsTodayHighlighted="True"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  SelectedDatesChanged="MainCalendar_SelectedDatesChanged"
                                  CalendarViewDayItemChanging="MainCalendar_CalendarViewDayItemChanging"/>

                    <!-- Daily Goal / Circular Progress Tracker -->
                    <Border CornerRadius="14" Padding="14,12" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#26FFFFFF">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock x:Name="DayProgressTrackerHeader" Text="Day Progress Tracker" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Circular Progress Ring with Center Content -->
                            <Grid Width="110" Height="110" HorizontalAlignment="Center">
                                <ProgressRing x:Name="DayProgressRing" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"
                                              Width="105" Height="105" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource SystemAccentColor}"/>

                                <!-- Center Content: Percentage & Fire / Celebration Badge -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                    <!-- Fire / Flame Effect (shown when 100% completed) -->
                                    <TextBlock x:Name="FlameBadge" Text="🔥" FontSize="26" HorizontalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform x:Name="FlameScale" ScaleX="1" ScaleY="1"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>

                                    <!-- Percentage Text -->
                                    <TextBlock x:Name="DayProgressPercentText" Text="0%" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Details below the circle -->
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <TextBlock x:Name="DayProgressDetailsText" Text="0 of 0 completed" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DayProgressRemainingText" Text="No tasks for this day" FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Celebration banner (when 100% completed) -->
                            <Border x:Name="CelebrationBanner" CornerRadius="8" Padding="10,6" Background="#26FF9800" BorderThickness="1" BorderBrush="#FF9800" Visibility="Collapsed" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="🔥" FontSize="14"/>
                                    <TextBlock x:Name="CelebrationText" Text="Day 100% Complete!" FontSize="12" FontWeight="Bold" Foreground="#FFB74D"/>
                                    <TextBlock Text="🔥" FontSize="14"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
