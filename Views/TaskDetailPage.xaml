<Page
    x:Class="ToDoListApp.Views.TaskDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Margin="0,90,0,0" Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side: Task Information -->
        <Border Grid.Column="0" Margin="0,0,20,0" CornerRadius="12" Padding="20">
            <Border.Background>
                <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
            </Border.Background>
            <ScrollViewer>
                <StackPanel Spacing="20">
                    <Button x:Name="BtnBack" Content="← Back" Click="GoBack_Click" Background="Transparent" BorderThickness="0"/>
                    <TextBox x:Name="TaskTitleBox" Text="{x:Bind Task.Title, Mode=TwoWay}" FontSize="32" FontWeight="Bold" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlElevationBorderBrush}" CornerRadius="8" Padding="12,8" PlaceholderText="Enter task title..."/>
                    
                    <TextBlock x:Name="TxtSubtasks" Text="Subtasks" FontSize="20" FontWeight="SemiBold"/>
                    <ListView ItemsSource="{x:Bind Task.Subtasks, Mode=OneWay}" CanReorderItems="True" AllowDrop="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding Title, Mode=TwoWay}" VerticalAlignment="Center" Margin="10,0,0,0" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0" CornerRadius="4" Padding="8,4" PlaceholderText="Subtask title..."/>
                                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="DeleteSubtask_Click" ToolTipService.ToolTip="Delete Subtask" Margin="5,0,0,0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="BtnAddSubtask" Content="+ Add Subtask" Click="AddSubtask_Click"/>

                    <TextBlock x:Name="TxtSettings" Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"/>
                    <DatePicker x:Name="DatePickerCtrl" Header="Date" Date="{x:Bind Task.Date, Mode=TwoWay}"/>
                    <TimePicker x:Name="TimePickerCtrl" Header="Time" Time="{x:Bind Task.Time, Mode=TwoWay}"/>
                    <TimePicker x:Name="ReminderPickerCtrl" Header="Reminder" />
                    <ComboBox x:Name="RepeatComboCtrl" Header="Repeat" SelectedValuePath="Tag" SelectedValue="{x:Bind Task.RepeatSetting, Mode=TwoWay}">
                        <ComboBoxItem x:Name="RepeatItemNone" Tag="None" Content="None"/>
                        <ComboBoxItem x:Name="RepeatItemDaily" Tag="Daily" Content="Daily"/>
                        <ComboBoxItem x:Name="RepeatItemWeekly" Tag="Weekly" Content="Weekly"/>
                        <ComboBoxItem x:Name="RepeatItemMonthly" Tag="Monthly" Content="Monthly"/>
                    </ComboBox>

                    <TextBlock x:Name="TxtNotes" Text="Notes" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"/>
                    <TextBox Text="{x:Bind Task.Notes, Mode=TwoWay}" AcceptsReturn="True" Height="100" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Side -->
        <Grid Grid.Column="1" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top-Right: Pomodoro Timer -->
            <Border x:Name="PomodoroCard" Grid.Row="0" CornerRadius="14" Padding="18" BorderThickness="2" Background="#99B71C1C" BorderBrush="#EF5350">
                <StackPanel Spacing="12">
                    <!-- Header with Title, Mode Badge, Mini Window button, Settings button -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPomodoro" Text="Pomodoro Timer" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Border x:Name="PomodoroModeBadge" CornerRadius="6" Background="#40FFFFFF" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="PomodoroModeText" Text="WORK" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <!-- Action buttons: Switch Mode, Float, Settings -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <!-- Toggle Work/Break -->
                            <Button x:Name="BtnToggleMode" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6" Click="TogglePomodoroMode_Click" ToolTipService.ToolTip="Switch Work / Break">
                                <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="White"/>
                            </Button>

                            <!-- Float / PiP -->
                            <Button x:Name="BtnFloatPomodoro" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6" Click="FloatPomodoro_Click" ToolTipService.ToolTip="Floating Window (Always on Top)">
                                <FontIcon Glyph="&#xE740;" FontSize="14" Foreground="White"/>
                            </Button>

                            <!-- Settings -->
                            <Button x:Name="BtnPomodoroSettings" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6" ToolTipService.ToolTip="Timer Settings">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="14" Width="240" Padding="4">
                                            <TextBlock x:Name="TxtTimerSettings" Text="Timer Settings" FontSize="16" FontWeight="Bold"/>

                                            <NumberBox x:Name="NumWorkMin" Header="Work Duration (min)" Minimum="1" Maximum="180" SmallChange="1" SpinButtonPlacementMode="Inline"/>
                                            <NumberBox x:Name="NumBreakMin" Header="Break Duration (min)" Minimum="1" Maximum="60" SmallChange="1" SpinButtonPlacementMode="Inline"/>

                                            <TextBlock x:Name="TxtPresets" Text="Presets" FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="25 / 5" HorizontalAlignment="Stretch" Click="Preset25_Click"/>
                                                <Button Grid.Column="1" Content="45 / 10" HorizontalAlignment="Stretch" Click="Preset45_Click"/>
                                                <Button Grid.Column="2" Content="50 / 10" HorizontalAlignment="Stretch" Click="Preset50_Click"/>
                                            </Grid>

                                            <Button x:Name="BtnSavePomodoro" Content="Save &amp; Apply" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SavePomodoroSettings_Click"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Big Timer Display -->
                    <TextBlock x:Name="PomodoroTimeText" Text="25:00" FontSize="52" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                    <!-- Control Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button x:Name="BtnStart" Content="Start" Style="{ThemeResource AccentButtonStyle}" Height="36" Width="80" Click="StartPomodoro_Click"/>
                        <Button x:Name="BtnPause" Content="Pause" Height="36" Width="80" Click="PausePomodoro_Click"/>
                        <Button x:Name="BtnStop" Content="Stop" Height="36" Width="80" Click="StopPomodoro_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bottom-Right: Files & Photos -->
            <Border Grid.Row="1" CornerRadius="12" Padding="20">
                <Border.Background>
                    <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
                </Border.Background>
                <StackPanel Spacing="10">
                    <TextBlock x:Name="TxtAttachments" Text="Attachments" FontSize="18" FontWeight="SemiBold"/>
                    <Button x:Name="BtnAddAttachment" Content="Add File/Photo" Click="AddAttachment_Click" HorizontalAlignment="Stretch"/>
                    <ListView ItemsSource="{x:Bind Task.Attachments, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" Margin="0,5"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

