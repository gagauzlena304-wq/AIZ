<Page
    x:Class="ToDoListApp.Views.ThemesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <!-- Title Top Right -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,20,20,0" CornerRadius="12" Padding="20,10">
            <Border.Background>
                <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
            </Border.Background>
            <TextBlock x:Name="TitleText" Text="Personalization" FontSize="28" FontWeight="Bold"/>
        </Border>

        <Grid Margin="20,90,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Click="UploadCustomWallpaper_Click" Margin="0,0,0,30" Padding="15,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets" />
                    <TextBlock x:Name="UploadCustomPhotoText" Text="Upload Custom Photo" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <GridView Grid.Row="1" ItemsSource="{x:Bind ThemeOptions, Mode=OneWay}" SelectionChanged="OnThemeSelected" SelectionMode="Single">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="250" Height="150" CornerRadius="12" Margin="10">
                        <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill" />
                        <Border Background="{Binding OverlayBrush}" />
                        
                        <StackPanel VerticalAlignment="Bottom" Padding="15" Background="#B2000000">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="18"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        </Grid>
    </Grid>
</Page>
