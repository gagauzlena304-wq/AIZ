<Page
    x:Class="ToDoListApp.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ToDoListApp.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <!-- Page Title Top Right -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,20,20,0" CornerRadius="12" Padding="20,10">
            <Border.Background>
                <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
            </Border.Background>
            <TextBlock x:Name="TitleText" Text="My Tasks" FontSize="28" FontWeight="Bold"/>
        </Border>

        <!-- Main 2-Column Content: Tasks on Left, Spacer (100px), Overview & Stats on Right -->
        <Grid Margin="25,90,25,20">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Tasks list for the day -->
                <ColumnDefinition Width="*" />
                <!-- Column 1: Spacing / Free space (100px) -->
                <ColumnDefinition Width="100" />
                <!-- Column 2: Overview & Stats card anchored to the right (380px) -->
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE: Tasks List and Day Header -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Day Header & Controls -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14" Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Day Title & Summary -->
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedDayTitleText" Text="Today, September 30" FontSize="26" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedDaySummaryText" Text="3 to do • 2 completed" FontSize="14" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                        </StackPanel>

                        <!-- Day Navigation & Add Task Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="PrevDayBtn" Click="PrevDay_Click" Height="36" Width="36" Padding="0" CornerRadius="8" BorderThickness="1" ToolTipService.ToolTip="Previous Day">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#28FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#45FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1FFFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#33FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#55FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#22FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource TextFillColorPrimary}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
                                </Button.Resources>
                                <FontIcon Glyph="&#xE76B;" FontSize="13"/>
                            </Button>
                            <Button x:Name="GoToTodayBtn" Click="GoToToday_Click" Content="Today" Height="36" Padding="14,0" CornerRadius="8" BorderThickness="1" FontSize="13" FontWeight="SemiBold">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#28FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#45FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1FFFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#33FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#55FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#22FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource TextFillColorPrimary}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
                                </Button.Resources>
                            </Button>
                            <Button x:Name="NextDayBtn" Click="NextDay_Click" Height="36" Width="36" Padding="0" CornerRadius="8" BorderThickness="1" ToolTipService.ToolTip="Next Day">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#28FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#45FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1FFFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#33FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#55FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#22FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource TextFillColorPrimary}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
                                </Button.Resources>
                                <FontIcon Glyph="&#xE76C;" FontSize="13"/>
                            </Button>

                            <Button Click="AddTask_Click" Style="{ThemeResource AccentButtonStyle}" Height="36" CornerRadius="8" Padding="14,0" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                    <TextBlock x:Name="AddTaskBtnText" Text="Add Task" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Daily Progress Bar -->
                    <ProgressBar x:Name="DayProgressBar" Value="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource SystemAccentColor}"/>
                </StackPanel>

                <!-- Tasks ListView -->
                <ListView x:Name="TasksListView" Grid.Row="1" ItemsSource="{x:Bind DisplayedTasks, Mode=OneWay}" SelectionChanged="OnTaskSelected">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                            <RepositionThemeTransition IsStaggeringEnabled="False"/>
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5,0,5" CornerRadius="8" DataContextChanged="TaskCard_DataContextChanged">
                                <Grid.RenderTransform>
                                    <TranslateTransform/>
                                </Grid.RenderTransform>
                                <Grid.Background>
                                    <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
                                </Grid.Background>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Main Task Row -->
                                <Grid Padding="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              Click="TaskCheckBox_Click"
                                              Loaded="TaskCheckBox_Loaded"
                                              VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="16"/>
                                        <Border Height="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                                Background="{ThemeResource SystemAccentColor}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    
                                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="DeleteTask_Click" ToolTipService.ToolTip="Delete Task" Margin="0,0,5,0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </Button>
                                    
                                    <ToggleButton Grid.Column="3" x:Name="ExpandSubtasksBtn" Background="Transparent" BorderThickness="0" CornerRadius="4">
                                        <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                                
                                <!-- Subtasks Panel -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Subtasks}" 
                                              Visibility="{Binding IsChecked, ElementName=ExpandSubtasksBtn, Converter={StaticResource BoolToVisibility}}"
                                              Margin="40,0,10,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4" DataContextChanged="SubtaskRow_DataContextChanged">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          Click="SubtaskCheckBox_Click"
                                                          Loaded="SubtaskCheckBox_Loaded"
                                                          VerticalAlignment="Center" MinWidth="0" MinHeight="0"/>
                                                <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                                                    <Border Height="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,3,0,0"
                                                            Background="{ThemeResource SystemBaseMediumColor}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="0"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State (when no tasks for this day) -->
                <Border x:Name="EmptyStatePanel" Grid.Row="1" CornerRadius="12" Padding="30" VerticalAlignment="Top" Margin="0,10,0,0" Visibility="Collapsed">
                    <Border.Background>
                        <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.6" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE73A;" FontSize="44" Foreground="{ThemeResource SystemBaseMediumColor}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateTitleText" Text="No tasks for this day" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                        <TextBlock x:Name="EmptyStateSubtext" Text="You're all caught up! Add a new task to plan your day." FontSize="13" Foreground="{ThemeResource SystemBaseMediumLowColor}" HorizontalAlignment="Center"/>
                        <Button x:Name="EmptyStateCreateTaskBtn" Content="+ Create Task" Click="AddTask_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT SIDE: Today's Overview & Statistics Card -->
            <Border Grid.Column="2" CornerRadius="16" Padding="20" VerticalAlignment="Top">
                <Border.Background>
                    <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
                </Border.Background>
                <StackPanel Spacing="16">
                    <!-- Card Header -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D2;" FontSize="18" Foreground="{ThemeResource SystemAccentColor}"/>
                        <TextBlock x:Name="DailyOverviewHeaderText" Text="Daily Overview" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Stat 1: To Do / Pending (Предстоит выполнить) -->
                    <Border CornerRadius="12" Padding="16,14" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#26FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="ToDoHeaderText" Text="To Do" FontSize="13" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                                <TextBlock x:Name="StatPendingCount" Text="0" FontSize="34" FontWeight="Bold" Foreground="#FFA726"/>
                                <TextBlock x:Name="ToDoSubtext" Text="tasks to complete" FontSize="11" Foreground="{ThemeResource SystemBaseMediumLowColor}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#26FFA726" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE823;" FontSize="18" Foreground="#FFA726" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Stat 2: Completed (Выполнено) -->
                    <Border CornerRadius="12" Padding="16,14" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#26FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="CompletedHeaderText" Text="Completed" FontSize="13" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                                <TextBlock x:Name="StatCompletedCount" Text="0" FontSize="34" FontWeight="Bold" Foreground="#66BB6A"/>
                                <TextBlock x:Name="CompletedSubtext" Text="tasks finished today" FontSize="11" Foreground="{ThemeResource SystemBaseMediumLowColor}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#2666BB6A" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="#66BB6A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Progress Block -->
                    <Border CornerRadius="12" Padding="16,14" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#26FFFFFF">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock x:Name="ProgressHeaderText" Text="Progress" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatProgressPercent" Text="0%" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="StatProgressBar" Value="0" Maximum="100" Height="6" CornerRadius="3" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock x:Name="StatMotivationalText" Text="Plan your tasks to get started!" FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                        </StackPanel>
                    </Border>

                    <!-- Filter Mode -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="FilterHeaderText" Text="View Filter" FontSize="12" Foreground="{ThemeResource SystemBaseMediumColor}"/>
                        <ComboBox x:Name="FilterComboBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="FilterComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="FilterItemAll" Content="All Tasks"/>
                            <ComboBoxItem x:Name="FilterItemPending" Content="Pending Only"/>
                            <ComboBoxItem x:Name="FilterItemCompleted" Content="Completed Only"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
