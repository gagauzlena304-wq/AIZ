<Page
    x:Class="ToDoListApp.Views.LanguagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <!-- Title Top Right -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,20,20,0" CornerRadius="12" Padding="20,10">
            <Border.Background>
                <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
            </Border.Background>
            <TextBlock x:Name="TitleText" Text="Language" FontSize="28" FontWeight="Bold" />
        </Border>

        <Border Margin="20,90,20,20" CornerRadius="12" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border.Background>
                <AcrylicBrush TintColor="{ThemeResource SystemAltHighColor}" TintOpacity="0.85" FallbackColor="{ThemeResource SystemChromeMediumColor}" />
            </Border.Background>
            <StackPanel Spacing="20">
                <ComboBox x:Name="LanguageComboBox" Header="Display Language" SelectionChanged="LanguageComboBox_SelectionChanged" Width="200" Loaded="LanguageComboBox_Loaded">
                    <ComboBoxItem Tag="en" Content="English" />
                    <ComboBoxItem Tag="ru" Content="Русский" />
                    <ComboBoxItem Tag="es" Content="Español" />
                    <ComboBoxItem Tag="de" Content="Deutsch" />
                    <ComboBoxItem Tag="ja" Content="日本語" />
                    <ComboBoxItem Tag="fr" Content="Français" />
                    <ComboBoxItem Tag="pt" Content="Português" />
                    <ComboBoxItem Tag="it" Content="Italiano" />
                </ComboBox>
            </StackPanel>
        </Border>
    </Grid>
</Page>

