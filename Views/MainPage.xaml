<Page
    x:Class="ToDoListApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <local:StringToImageSourceConverter x:Key="ImageConverter" xmlns:local="using:ToDoListApp.Converters" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Wallpaper Background -->
        <Image Source="{x:Bind ViewModel.Settings.WallpaperPath, Mode=OneWay, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill" />

        <SplitView IsPaneOpen="{x:Bind ViewModel.IsMenuOpen, Mode=TwoWay}" DisplayMode="Overlay" OpenPaneLength="250">
            <SplitView.Pane>
                <Grid>
                    <Grid.Background>
                        <AcrylicBrush TintOpacity="0.8" />
                    </Grid.Background>
                    <StackPanel Spacing="10" Margin="10,40,10,10">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="10,0,0,15" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8">
                                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="AIZ" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="NavThemesBtn" Content="Themes" HorizontalAlignment="Stretch" Click="NavThemes_Click"/>
                        <Button x:Name="NavNotifsBtn" Content="Notifications" HorizontalAlignment="Stretch" Click="NavNotifications_Click"/>
                        <Button x:Name="NavDateTimeBtn" Content="Date &amp; Time" HorizontalAlignment="Stretch" Click="NavDateTime_Click"/>
                        <Button x:Name="NavLanguageBtn" Content="Language" HorizontalAlignment="Stretch" Click="NavLanguage_Click"/>
                    </StackPanel>
                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid>
                    <!-- Main Content Frame -->
                    <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />

                    <!-- Top-Left Compact Navigation Bar -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" CornerRadius="12" Padding="5">
                        <Border.Background>
                            <AcrylicBrush TintColor="Black" TintOpacity="0.75" FallbackColor="#B2000000" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <!-- Menu -->
                            <Button x:Name="NavMenuBtn" Command="{x:Bind ViewModel.ToggleMenuCommand}" Background="Transparent" BorderThickness="0" Foreground="White" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,5">
                                    <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                    <TextBlock x:Name="NavMenuText" Text="Menu" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Tasks -->
                            <Button x:Name="NavTasksBtn" Click="NavTasks_Click" Background="Transparent" BorderThickness="0" Foreground="White" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,5">
                                    <Border Width="15" Height="15"
                                            BorderBrush="White"
                                            BorderThickness="1"
                                            Background="Black"
                                            CornerRadius="3"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE73E;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="9"
                                                  Foreground="White"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="NavTasksText" Text="Tasks" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Calendar -->
                            <Button x:Name="NavCalendarBtn" Click="NavCalendar_Click" Background="Transparent" BorderThickness="0" Foreground="White" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,5">
                                    <FontIcon Glyph="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                    <TextBlock x:Name="NavCalendarText" Text="Calendar" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Profile -->
                            <Button x:Name="NavProfileBtn" Click="NavProfile_Click" Background="Transparent" BorderThickness="0" Foreground="White" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="10,5">
                                    <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                    <TextBlock x:Name="NavProfileText" Text="Profile" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>




